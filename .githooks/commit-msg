#!/bin/sh

set -e

subject=$(sed -n '/^[[:space:]]*#/d; /^[[:space:]]*$/d; p; q' "$1")

case "$subject" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ *)
	exit 0
	;;
esac

if [ ${#subject} -gt 100 ]; then
	echo "error: commit subject must be 100 characters or less" >&2
	exit 1
fi

if printf '%s\n' "$subject" | grep -Eq '\.$'; then
	echo "error: commit subject must not end with a period" >&2
	exit 1
fi

if ! printf '%s\n' "$subject" | grep -Eiq '^(feat|fix|refactor|chore|test|style|docs|perf|build|ci)(\([a-z0-9._-]+\))?!?: [[:alnum:]].*( \[skip ci\])?$'; then
	cat >&2 <<'EOF'
error: commit subject must use Conventional Commits:
  <type>(<scope>): <description>

examples:
  fix(schedule): restore teacher session state
  feat: Add login flow [skip ci]
  docs: improve readme

allowed types: feat, fix, refactor, chore, test, style, docs, perf, build, ci
EOF
	exit 1
fi
