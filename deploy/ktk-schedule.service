[Unit]
Description=KTK Telegram schedule bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ktk-schedule
Group=ktk-schedule
WorkingDirectory=/var/lib/ktk-schedule
EnvironmentFile=/etc/ktk-schedule/bot.env
ExecStart=/opt/ktk-schedule/ktk-schedule
StateDirectory=ktk-schedule
StateDirectoryMode=0700
Restart=on-failure
RestartSec=10
TimeoutStopSec=35
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
