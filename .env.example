# Copy this file to .env and fill in the required values.
# Generate CREDENTIALS_SECRET with: openssl rand -base64 32

# Required
BOT_TOKEN=
CREDENTIALS_SECRET=

# Owner commands
OWNER_TELEGRAM_ID=123456789

# Workspace API
KTK_BASE_URL=https://workspace.ktk-45.ru
KTK_DEVICE_NAME=ktk-schedule
KTK_DEBUG_SCHEDULE=false

# Defaults
DEFAULT_GROUP_ID=269
DEFAULT_SUBGROUP=1

# Notifications
NOTIFY_TIME=07:30
TIMEZONE=Asia/Yekaterinburg

# Storage
DATABASE_PATH=ktk-schedule.db

# Runtime
LOG_LEVEL=info
HEALTH_ADDR=127.0.0.1:8080
HEALTH_PORT=8080
PPROF_ENABLED=false
