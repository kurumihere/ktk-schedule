# Local development: copy to .env and use the TEST bot token.
# Production keeps settings in /etc/ktk-schedule/<instance>/bot.env and the three secrets
# (BOT_TOKEN, CREDENTIALS_SECRET, VK_GROUP_TOKEN) as systemd credentials (deploy/install.sh).
BOT_TOKEN=
# Generate once: openssl rand -base64 32. Keep it stable: it seals saved site sessions
# and caches. No password is ever stored.
CREDENTIALS_SECRET=

OWNER_TELEGRAM_ID=0
# HTTPS is required; credentials must never travel over plain HTTP.
KTK_BASE_URL=https://ktk.education-system.ru/
KTK_DEVICE_NAME=ktk-schedule
DEFAULT_GROUP_ID=269
DEFAULT_SUBGROUP=1
NOTIFY_TIME=07:30
TIMEZONE=Asia/Yekaterinburg

DATABASE_PATH=data/test-bot.sqlite3
RUST_LOG=ktk_schedule=info,teloxide=warn

# Optional VK bot: VK_GROUP_TOKEN needs VK_GROUP_ID; leave both empty to disable VK.
VK_GROUP_TOKEN=
VK_GROUP_ID=
OWNER_VK_ID=0
VK_API_URL=https://api.vk.com/method/
