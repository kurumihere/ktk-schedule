# Copy to .env and use the TEST bot token for local development.
# Production uses a separate .env in the service working directory.
BOT_TOKEN=
# Generate once: openssl rand -base64 32
# Keep this value stable: it encrypts saved workspace passwords.
CREDENTIALS_SECRET=

OWNER_TELEGRAM_ID=0
KTK_BASE_URL=https://workspace.ktk-45.ru/
KTK_DEVICE_NAME=ktk-schedule
DEFAULT_GROUP_ID=269
DEFAULT_SUBGROUP=1
NOTIFY_TIME=07:30
TIMEZONE=Asia/Yekaterinburg

# Fresh Rust database, separate from Go and production data.
DATABASE_PATH=data/test-bot.sqlite3
RUST_LOG=ktk_schedule=info,teloxide=warn
