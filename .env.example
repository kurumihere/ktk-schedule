# ktk-schedule configuration
#
# Copy to .env and fill in the required fields.
# Скопируйте в .env и заполните обязательные поля.
#
# Generate a secure CREDENTIALS_SECRET:
#   openssl rand -base64 32
#
# Get a bot token from @BotFather and put it in BOT_TOKEN.
# Узнать свой Telegram ID для OWNER_TELEGRAM_ID: /my_id

# ──────────────────────────────────────────────
# Required / Обязательные
# ──────────────────────────────────────────────

# Telegram bot token from @BotFather
# Токен бота от @BotFather
BOT_TOKEN=

# Secret key for password encryption, at least 32 characters
# Ключ шифрования паролей, минимум 32 символа
CREDENTIALS_SECRET=

# ──────────────────────────────────────────────
# Bot / Бот
# ──────────────────────────────────────────────

# Owner Telegram ID — who can use /announce command
# Telegram ID владельца — кому доступна команда /announce
# Find it with /my_id after starting the bot
# Узнать через /my_id после запуска бота
OWNER_TELEGRAM_ID=123456789

# ──────────────────────────────────────────────
# Workspace API
# ──────────────────────────────────────────────

# Workspace base URL
# Базовый URL workspace
KTK_BASE_URL=https://workspace.ktk-45.ru

# Device name sent with sign-in requests
# Имя устройства для sign-in запроса
KTK_DEVICE_NAME=ktk-schedule

# ──────────────────────────────────────────────
# Schedule / Расписание
# ──────────────────────────────────────────────

# Manual endpoint overrides (optional — auto-discovery works by default)
# Ручное указание endpoint-ов (необязательно — автопоиск работает по умолчанию)
# KTK_SCHEDULE_PATH=/v0/root/tenant/schedule
# KTK_LECTURE_HALL_PATH=/v0/root/tenant/lecture-hall
# KTK_CALL_PRESET_PATH=/v0/root/tenant/call-preset
# KTK_BRANCH_ID=abc123

# Log the first raw schedule item for diagnostics
# Логировать первый элемент расписания в сыром виде (для отладки)
KTK_DEBUG_SCHEDULE=false

# ──────────────────────────────────────────────
# Defaults / По умолчанию
# ──────────────────────────────────────────────

# Default group ID after first /login
# Группа после первого /login
DEFAULT_GROUP_ID=269

# Default subgroup: 1 or 2
# Подгруппа по умолчанию: 1 или 2
DEFAULT_SUBGROUP=1

# ──────────────────────────────────────────────
# Notifications / Уведомления
# ──────────────────────────────────────────────

# Morning notification time (HH:MM format)
# Время утренней рассылки (формат HH:MM)
NOTIFY_TIME=07:30

# Timezone
# Таймзона
TIMEZONE=Asia/Yekaterinburg

# ──────────────────────────────────────────────
# Database / База данных
# ──────────────────────────────────────────────

# Path to SQLite file
# Путь к SQLite файлу
DATABASE_PATH=ktk-schedule.db

# For Docker (persistent volume mount):
# Для Docker (примонтированный том):
# DATABASE_PATH=/app/data/ktk-schedule.db

# ──────────────────────────────────────────────
# Logging / Логи
# ──────────────────────────────────────────────

# Log level: debug, info, warn, error
# Уровень логирования: debug, info, warn, error
LOG_LEVEL=info

# ──────────────────────────────────────────────
# Monitoring / Мониторинг
# ──────────────────────────────────────────────

# HTTP port for /health endpoint
# Порт для HTTP /health
HEALTH_PORT=8080
